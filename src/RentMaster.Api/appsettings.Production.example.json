{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=RentMasterDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Issuer": "https://your-rentmaster-domain.example",
    "Audience": "https://your-rentmaster-domain.example",
    "SigningKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Verification": {
    "NumberHashPepper": "REPLACE_WITH_A_SEPARATE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "MaximumFileSizeBytes": 5242880,
    "RequiredDocuments": [
      "Aadhaar",
      "Passport"
    ],
    "MinimumVerifiedDocuments": 1,
    "AutoApproveSubmissions": false
  },
  "DocumentStorage": {
    "RootPath": "/var/lib/rentmaster/private-files"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/rentmaster/data-protection-keys"
  },
  "AllowedOrigins": [
    "https://your-rentmaster-domain.example"
  ],
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "AdminSeed": {
    "Enabled": false,
    "Email": "",
    "Password": ""
  },
  "AllowedHosts": "your-rentmaster-domain.example"
}
